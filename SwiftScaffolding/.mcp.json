{
  "mcpServers": {
    "XcodeBuildMCP": {
      "command": "npx",
      "args": [
        "-y",
        "xcodebuildmcp@latest",
        "mcp"
      ],
      "env": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "project-scaffolding",
        "XCODEBUILDMCP_SENTRY_DISABLED": "true"
      }
    }
  }
}